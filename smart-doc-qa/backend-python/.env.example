# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Cohere Re-ranking
COHERE_API_KEY=your_cohere_api_key_here

# Vector DB (choose one)
VECTOR_DB=faiss           # faiss | chroma | pinecone
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_PATH=./faiss_index

# Pinecone (if using)
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_INDEX=

# Embeddings model
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5   # local open-source
# EMBEDDING_MODEL=text-embedding-3-large  # OpenAI

# RAG settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
